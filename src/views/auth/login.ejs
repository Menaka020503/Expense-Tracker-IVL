<!doctype html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <main class="auth-page">
    <div class="auth-card">
      <h1>Welcome back</h1>
      <p class="muted">Log in to view your dashboard.</p>
      <div id="form-message" class="form-message" hidden></div>
      <form id="login-form" method="POST" action="/api/auth/login" novalidate>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />

        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />

        <button type="submit" class="btn btn-primary btn-block">Login</button>
      </form>
      <p class="auth-switch">Need an account? <a href="/register">Register</a></p>
    </div>
  </main>
  <script src="/js/main.js"></script>
</body>
</html>
