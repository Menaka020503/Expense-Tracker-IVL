<!doctype html>
<html lang="en">
<%- include('../partials/head') %>
<body>
<%- include('../partials/nav') %>
  <main class="container page">
    <div class="page-header">
      <h1>Transactions</h1>
      <a href="/transactions/add" class="btn btn-primary">+ Add Transaction</a>
    </div>

    <form class="filter-bar" method="GET" action="/transactions">
      <select name="type">
        <option value="">All types</option>
        <option value="income" <%= filters.type === 'income' ? 'selected' : '' %>>Income</option>
        <option value="expense" <%= filters.type === 'expense' ? 'selected' : '' %>>Expense</option>
      </select>

      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c._id %>" <%= filters.category === String(c._id) ? 'selected' : '' %>><%= c.name %> (<%= c.type %>)</option>
        <% }) %>
      </select>

      <input type="date" name="from" value="<%= filters.from %>" placeholder="From" />
      <input type="date" name="to" value="<%= filters.to %>" placeholder="To" />

      <button type="submit" class="btn btn-secondary">Filter</button>
      <a href="/transactions" class="btn btn-ghost">Reset</a>
    </form>

    <section class="panel">
      <% if (transactions.length === 0) { %>
        <p class="empty-state">No transactions match these filters.</p>
      <% } else { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Title</th>
              <th>Category</th>
              <th>Type</th>
              <th class="text-right">Amount</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach(function(tx) { %>
              <tr>
                <td><%= new Date(tx.date).toLocaleDateString() %></td>
                <td><a href="/transactions/<%= tx._id %>"><%= tx.title %></a></td>
                <td><%= tx.categoryId ? tx.categoryId.name : '—' %></td>
                <td><span class="badge badge-<%= tx.type %>"><%= tx.type %></span></td>
                <td class="text-right"><%= tx.type === 'expense' ? '-' : '+' %>₹<%= tx.amount.toFixed(2) %></td>
                <td class="text-right row-actions">
                  <a href="/transactions/<%= tx._id %>/edit" class="link">Edit</a>
                  <button class="link danger delete-transaction" data-id="<%= tx._id %>">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <nav class="pagination">
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <a
              class="page-link <%= p === pagination.page ? 'active' : '' %>"
              href="/transactions?page=<%= p %>&type=<%= filters.type %>&category=<%= filters.category %>&from=<%= filters.from %>&to=<%= filters.to %>"
            ><%= p %></a>
          <% } %>
        </nav>
      <% } %>
    </section>
  </main>
<%- include('../partials/footer') %>
</body>
</html>
